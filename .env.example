PORT=4000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/test?retryWrites=true&w=majority

BASE_URL=http://localhost:6007

# Required for admin JWT auth
AUTH_SECRET=your-secret-here

# Optional — Cloudflare R2 for blog images in production
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=
# R2_UPLOAD_PREFIX=blogs/

# Optional
TEAMS_WEBHOOK_URL_CAREERS=
TEAMS_WEBHOOK_URL=
